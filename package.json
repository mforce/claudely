{
  "name": "claudely",
  "version": "0.1.0",
  "description": "Launch Claude Code against a local LLM (LM Studio, Ollama, llama.cpp, or any Anthropic-compatible endpoint). Unaffiliated community helper.",
  "license": "MIT",
  "author": "mforce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mforce/claudely.git"
  },
  "homepage": "https://github.com/mforce/claudely#readme",
  "bugs": {
    "url": "https://github.com/mforce/claudely/issues"
  },
  "bin": {
    "claudely": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "smoke": "node dist/cli.js --help",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "local-llm",
    "lm-studio",
    "ollama",
    "llama.cpp",
    "cli"
  ]
}
