{
  "name": "loclaude",
  "version": "0.1.0",
  "description": "Launch Claude Code against a local LLM (LM Studio, Ollama, llama.cpp, or any Anthropic-compatible endpoint). Unaffiliated community helper.",
  "license": "MIT",
  "author": "mforce",
  "type": "module",
  "bin": {
    "loclaude": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "smoke": "node dist/cli.js --help"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "local-llm",
    "lm-studio",
    "ollama",
    "llama.cpp",
    "cli"
  ]
}
